{
  "name": "tokenlens",
  "version": "1.1.1",
  "private": true,
  "description": "TokenLens · DeepSeek Harness 与 WorkBuddy 的 Windows 浮动用量显示器：模块归因、模型分布、逐轮上下行、每日统计",
  "main": "src/main/main.js",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "token-usage",
    "floating-widget",
    "windows",
    "electron"
  ],
  "author": "柒仔",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "demo": "node scripts/start.js --demo",
    "panel": "node scripts/serve.js --port 4317 --open",
    "panel:demo": "node scripts/serve.js --port 4317 --demo --open",
    "icon": "node scripts/make-icon.js",
    "doctor": "node scripts/doctor.js",
    "pack": "node scripts/pack.js",
    "build:win": "node scripts/build-win.js --zip"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.tokenlens.app",
    "productName": "TokenLens",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linusxch/tokenlens.git"
  },
  "homepage": "https://github.com/linusxch/tokenlens#readme",
  "bugs": {
    "url": "https://github.com/linusxch/tokenlens/issues"
  }
}
